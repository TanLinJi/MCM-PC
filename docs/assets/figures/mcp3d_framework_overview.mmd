flowchart LR
    subgraph IN[DUAL INPUTS 双输入]
        TIN[Text-side input 文本侧输入<br/>offline class names + DeepSeek paraphrases]
        XIN[Point-cloud input 点云主输入<br/>online corrupted point cloud X_t]
    end

    subgraph ENC[ENCODERS 编码]
        TENC[Text encoder + vMF MAP<br/>build text anchor bank A_T]
        VENC[3D-VLM encoder<br/>global feature h_g<br/>local patches h_l<br/>probability p]
    end

    subgraph CORE[CORE: 2 x 3 MULTI-MEMORY MATRIX 核心多缓存矩阵]
        AT[Text anchor bank A_T<br/>semantic class prototypes]
        FS[Feature stream<br/>h_g, h_l, entropy H(p)]

        subgraph MATRIX[Representation axis x Functional axis]
            direction TB
            subgraph R1[Global row]
                direction LR
                GC[global_conf<br/>low entropy whole-shape feature]
                GCOMP[global_comp<br/>small Omega<br/>feature + ICP-CD geometry]
                GBND[global_bnd<br/>mid entropy soft labels]
            end
            subgraph R2[Local row]
                direction LR
                LC[local_conf<br/>low entropy patch features]
                LCOMP[local_comp<br/>patch ICP-CD geometry]
                LBND[local_bnd<br/>optional ablation]
            end
        end

        GEO[C1 geometry selector inside compactness column<br/>PCA pre-align -> rigid ICP R,t no scale -> Chamfer Distance -> Omega]
        READ[Memory readout<br/>confidence + compactness are positive<br/>boundary is subtractive]
    end

    subgraph OUT[OUTPUTS 输出]
        FUSE[Multi-source fusion<br/>text logits + positive memory logits - boundary suppression]
        PRED[Prediction<br/>y_hat = argmax final logits]
        UPD[Online memory update<br/>write selected sample back to matrix]
        DIAG[Offline diagnosis<br/>C2: compactness Phi(c) vs accuracy, Pearson r]
    end

    TIN --> TENC --> AT --> FUSE
    XIN ==> VENC ==> FS ==> MATRIX --> READ --> FUSE --> PRED --> UPD
    GEO --> GCOMP
    GEO --> LCOMP
    UPD -. update memory .-> MATRIX
    UPD -. logs .-> DIAG

    classDef input fill:#eff6ff,stroke:#60a5fa,color:#0f172a;
    classDef feature fill:#ecfdf5,stroke:#34d399,color:#0f172a;
    classDef core fill:#faf5ff,stroke:#a855f7,color:#0f172a;
    classDef compact fill:#fff7ed,stroke:#fb923c,color:#0f172a;
    classDef boundary fill:#fff1f2,stroke:#fb7185,color:#0f172a;
    classDef output fill:#f0f9ff,stroke:#38bdf8,color:#0f172a;
    classDef diag fill:#f1f5f9,stroke:#94a3b8,color:#0f172a;

    class TIN,XIN input;
    class TENC,VENC,FS,UPD feature;
    class AT,MATRIX,GC,LC,READ core;
    class GCOMP,LCOMP,GEO compact;
    class GBND,LBND boundary;
    class FUSE,PRED output;
    class DIAG diag;
